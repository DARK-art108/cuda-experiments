{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "mkdir -p ${workspaceFolder}/build && /opt/homebrew/bin/g++-16 -std=c++20 -O2 -Wall -Wextra -o ${workspaceFolder}/build/${fileBasenameNoExtension} ${file}",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SDKROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run",
            "type": "shell",
            "command": "${workspaceFolder}/build/${fileBasenameNoExtension}",
            "options": {
                // run from the source file's directory so a sibling input.txt is found
                "cwd": "${fileDirname}"
            },
            "dependsOn": ["build"],
            "problemMatcher": []
        },
        {
            "label": "debug build (LOCAL)",
            "type": "shell",
            "command": "mkdir -p ${workspaceFolder}/build && /opt/homebrew/bin/g++-16 -std=c++20 -g -O0 -DLOCAL -Wall -Wextra -o ${workspaceFolder}/build/${fileBasenameNoExtension}_dbg ${file}",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SDKROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
                }
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run with input.txt (LOCAL)",
            "type": "shell",
            "command": "${workspaceFolder}/build/${fileBasenameNoExtension}_dbg < ${fileDirname}/input.txt",
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": ["debug build (LOCAL)"],
            "problemMatcher": []
        }
    ]
}
