{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "mkdir -p build && /opt/homebrew/bin/g++-16 -std=c++20 -Wall -Wextra -O2 -o build/${fileBasenameNoExtension} ${file}",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SDKROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run",
            "type": "shell",
            "command": "./build/${fileBasenameNoExtension}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": ["build"],
            "problemMatcher": []
        }
    ]
}
